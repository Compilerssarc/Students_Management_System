<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="22.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.system.studentmanagementsystem.AuthController" style="-fn-background-color: #F8F9FA;">
    <padding>
        <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
    </padding>

    <Label text="System Access" textFill="#333333">
        <font>
            <Font name="System Bold" size="26.0" />
        </font>
        <VBox.margin>
            <Insets bottom="5.0" />
        </VBox.margin>
    </Label>

    <TextField fx:id="txtUsername" prefHeight="42.0" prefWidth="280.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #ced4da; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-text-fill: #333333;">
        <padding>
            <Insets left="10.0" right="10.0" />
        </padding>
    </TextField>

    <PasswordField fx:id="txtPassword" promptText="Password" prefHeight="42.0" prefWidth="280.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #ced4da; -fx-border-width: 1.5; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 14px; -fx-text-fill: #333333;">
        <padding>
            <Insets left="10.0" right="10.0" />
        </padding>
    </PasswordField>

    <Label fx:id="lblMessage" wrapText="true" alignment="CENTER" textAlignment="CENTER" maxWidth="280.0">
        <font>
            <Font name="System Regular" size="13.0" />
        </font>
    </Label>

    <HBox spacing="16.0" alignment="CENTER" prefWidth="280.0">
        <Button text="Login" onAction="#handleLogin" prefHeight="42.0" prefWidth="132.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
        <Button text="Sign Up" onAction="#handleSignup" prefHeight="42.0" prefWidth="132.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>
</VBox>